AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
TABLE_NAME=LLMTeamQuota
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Daily Slack quota report (leave SLACK_WEBHOOK_URL unset to disable)
# Reports are de-duplicated across processes via a lock table (LOCK_TABLE_NAME) with TTL on "expiresAt"
SLACK_WEBHOOK_URL=
# Comma-separated 24h local hours to post the report, e.g. "9,23"
SLACK_REPORT_HOURS=9,23
SLACK_REPORT_TZ=Asia/Singapore
LOCK_TABLE_NAME=LLMReportLock

# Admin bulk quota update endpoint (PUT /api/admin/quota); leave ADMIN_TOKEN unset to disable
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
# Per-team daily token-limit increase allowance (rolling 24h); decreases are always allowed
ADMIN_DAILY_LIMIT=2000000
